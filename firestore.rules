rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the project administrator (Firebase Console / Admin SDK) can approve accounts.
    function approved() {
      return request.auth != null && request.auth.token.email_verified == true &&
        get(/databases/$(database)/documents/approvedUsers/$(request.auth.uid)).data.enabled == true;
    }
    function owner(uid) { return approved() && request.auth.uid == uid; }
    match /approvedUsers/{uid} {
      // A single explicit access check is allowed even before approval.
      allow get: if request.auth != null && request.auth.uid == uid;
      // Self-registration is create-only, never approval or revocation.
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com' &&
        request.resource.data.keys().hasAll(['enabled','email','createdAt']) &&
        request.resource.data.keys().hasOnly(['enabled','email','createdAt']) &&
        request.resource.data.enabled == false &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }
    function valid() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind','payload','deleted','version','updatedAt']) &&
        d.keys().hasOnly(['kind','payload','deleted','version','updatedAt']) &&
        d.kind in ['TASK','SESSION','FURNITURE','ITEM','GROUP','SHOPPING','PURCHASE','HOME','SHOPPING_LIST','RECIPE'] &&
        d.payload is string && d.payload.size() <= 200000 && d.deleted is bool &&
        d.version is int && d.version >= 1 && d.updatedAt == request.time;
    }
    match /users/{uid}/records/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid() && request.resource.data.version == 1;
      allow update: if owner(uid) && valid() && request.resource.data.version == resource.data.version + 1 && request.resource.data.kind == resource.data.kind;
      allow delete: if false; // durable tombstones; no direct destructive delete
    }
    function signed() { return approved(); }
    function space(id) { return get(/databases/$(database)/documents/sharedSpaces/$(id)); }
    function member(id) { return get(/databases/$(database)/documents/memberships/$(id + '~' + request.auth.token.email)); }
    function isOwner(id) { return signed() && space(id).data.ownerUid == request.auth.uid; }
    function role(id, roles) { return signed() && member(id).data.status == 'accepted' && member(id).data.acceptedUid == request.auth.uid && member(id).data.role in roles; }
    function active(d) { return d.get('archived',false) == false; }
    function collectionActive(d) {
      return active(d) && (d.kind!='furniture' || active(space(d.parentId).data));
    }
    function inherited(d, roles) {
      return signed() && d.kind=='furniture' && d.parentId is string && d.parentId.size()>0 &&
        space(d.parentId).data.kind=='house' && active(space(d.parentId).data) && space(d.parentId).data.ownerUid==d.ownerUid &&
        role(d.parentId,roles);
    }
    function canRead(id) { return signed() && collectionActive(space(id).data) && (isOwner(id) || role(id,['reader','editor','admin']) || inherited(space(id).data,['reader','editor','admin'])); }
    function manager(id) { return isOwner(id) || role(id,['admin']); }
    function writer(id) { return signed() && collectionActive(space(id).data) && (isOwner(id) || role(id,['editor','admin']) || inherited(space(id).data,['editor','admin'])); }
    function validSpace() {
      let d=request.resource.data;
      return d.keys().hasOnly(['ownerUid','kind','title','body','version','updatedAt','sourceId','parentId','homeName']) &&
        d.kind in ['task','project','home','shopping','house','furniture','shopping_list'] && d.ownerUid is string && d.title is string && d.title.size()>0 && d.title.size()<=180 &&
        d.body is string && d.body.size()<=50000 && d.version is int && d.updatedAt==request.time &&
        (!(d.kind in ['house','furniture','shopping_list']) || (d.sourceId is string && d.sourceId.size()>0 && d.sourceId.size()<=180 && d.parentId is string && d.homeName is string && d.homeName.size()<=180 &&
          (d.kind=='furniture' ? (d.parentId.size()>0 && space(d.parentId).data.kind=='house' && active(space(d.parentId).data) && space(d.parentId).data.ownerUid==d.ownerUid) : d.parentId=='')));
    }
    match /sharedSpaces/{id} {
      allow get: if signed() && (resource == null || resource.data.ownerUid==request.auth.uid || (collectionActive(resource.data) && (role(id,['reader','editor','admin']) || inherited(resource.data,['reader','editor','admin']))));
      allow list: if signed() && (resource.data.ownerUid==request.auth.uid || inherited(resource.data,['reader','editor','admin']));
      allow create: if signed() && validSpace() && request.resource.data.ownerUid==request.auth.uid && request.resource.data.version==1;
      allow update: if request.resource.data.version==resource.data.version+1 && (
        (writer(id) && validSpace() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','version','updatedAt'])) ||
        (isOwner(id) && collectionActive(resource.data) && resource.data.kind in ['house','furniture','shopping_list'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived','body','version','updatedAt']) &&
          request.resource.data.archived==true &&
          request.resource.data.body==(resource.data.kind=='furniture' ? '{"furniture":{"name":"","type":"OTHER"}}' : '{}') &&
          request.resource.data.updatedAt==request.time)
      );
      allow delete: if false;
      match /comments/{cid} {
        allow read: if canRead(id);
        allow create: if writer(id) && request.resource.data.keys().hasOnly(['authorUid','body','createdAt']) && request.resource.data.authorUid==request.auth.uid && request.resource.data.body is string && request.resource.data.body.size()>0 && request.resource.data.body.size()<=2000 && request.resource.data.createdAt==request.time;
        allow update, delete: if false;
      }
    }
    match /memberships/{mid} {
      function validMembership() {
        let d=request.resource.data;
        return d.keys().hasOnly(['spaceId','email','role','status','invitedBy','acceptedUid','expiresAt','updatedAt']) && d.spaceId is string && d.email is string && d.email.size()<=254 && mid==d.spaceId+'~'+d.email && d.role in ['reader','editor','admin'] && d.status in ['pending','accepted','declined'] && d.acceptedUid is string && d.expiresAt is timestamp && d.updatedAt==request.time;
      }
      function inviteAllowed() { return manager(request.resource.data.spaceId) && (isOwner(request.resource.data.spaceId) || request.resource.data.role!='admin'); }
      allow read: if signed() && (resource.data.email==request.auth.token.email || manager(resource.data.spaceId));
      allow create: if signed() && validMembership() && inviteAllowed() && request.resource.data.invitedBy==request.auth.uid && request.resource.data.status=='pending' && request.resource.data.acceptedUid=='' && request.resource.data.expiresAt>request.time && request.resource.data.expiresAt<=request.time+duration.value(8,'d');
      allow update: if signed() && validMembership() && (
        (resource.data.email==request.auth.token.email && resource.data.status=='pending' && resource.data.expiresAt>request.time && ((request.resource.data.status=='accepted' && request.resource.data.acceptedUid==request.auth.uid) || (request.resource.data.status=='declined' && request.resource.data.acceptedUid=='')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','updatedAt'])) ||
        (inviteAllowed() && (isOwner(resource.data.spaceId) || resource.data.role!='admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','invitedBy','acceptedUid','expiresAt','updatedAt']) && request.resource.data.invitedBy==request.auth.uid && request.resource.data.status=='pending' && request.resource.data.acceptedUid=='' && request.resource.data.expiresAt>request.time && request.resource.data.expiresAt<=request.time+duration.value(8,'d')));
      allow delete: if signed() && (resource.data.email==request.auth.token.email || isOwner(resource.data.spaceId) || (role(resource.data.spaceId,['admin']) && resource.data.role!='admin'));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
